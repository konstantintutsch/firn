# Encrypts the Garmin keys in the database. At least 32 characters, for example
# from `openssl rand -base64 32`. Changing it makes saved keys unreadable.
APP_SECRET=

# The address people open Runmap at. The OpenID Connect provider sends them back here.
PUBLIC_URL=http://localhost:8080

# An OpenID Connect client at your provider, with the redirect URI
# ${PUBLIC_URL}/api/auth/callback. Leave the secret empty for a public client.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional, from before accounts: the first account to sign in takes it over.
# Everyone else adds their own key in the settings.
GARMIN_PERSONAL_API_KEY=

# Optional: syncs every account with a Garmin key every this many hours, so that
# new activities show up without selecting Sync. 0 turns it off.
SYNC_INTERVAL_HOURS=0
