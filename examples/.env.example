# The images the Images workflow pushes to.
FIRN_IMAGES=ghcr.io/konstantintutsch/firn
# A tag like 1.2.3, or latest for the newest stable release.
FIRN_VERSION=latest

# A long random password, for example from `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Encrypts the Garmin keys in the database. At least 32 characters, for example
# from `openssl rand -base64 32`. Changing it makes saved keys unreadable.
APP_SECRET=

# The address your proxy serves, like https://firn.example.com.
PUBLIC_URL=

# An OpenID Connect client with the redirect URI ${PUBLIC_URL}/api/auth/callback.
# Leave the secret empty for a public client.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: syncs every account with a Garmin key every this many hours, so that
# new activities show up without selecting Sync. 0 turns it off.
SYNC_INTERVAL_HOURS=0
