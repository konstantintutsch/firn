# Where the Images workflow pushes to: the registry and owner, like
# gitea.example.com/you. Runmap adds /runmap-api and /runmap-web.
RUNMAP_IMAGES=
# A tag like 1.2.3, or latest for the newest build of main.
RUNMAP_VERSION=latest

# For caddy/ and traefik/: the domain Runmap runs at, like runmap.example.com.
DOMAIN=
# For compose.yaml only: the address your proxy serves, like https://runmap.example.com.
PUBLIC_URL=

# A long random password, for example from `openssl rand -base64 32`.
POSTGRES_PASSWORD=
# Encrypts the Garmin keys in the database. At least 32 characters, for example
# from `openssl rand -base64 32`. Changing it makes saved keys unreadable.
APP_SECRET=

# An OpenID Connect client with the redirect URI https://DOMAIN/api/auth/callback.
# Leave the secret empty for a public client.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
