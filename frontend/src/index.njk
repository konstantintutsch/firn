<!doctype html>
<html lang="en">
  {%- set title = "Runmap" %}
  {%- set map = true %}
  {% include "head.njk" %}
  <body>
    <main id="map" aria-label="Heatmap of all activities" data-i18n-attrs="aria-label"></main>
    <section class="panel">
      <div class="panel-body">
        {% include "header.njk" %}
        <button id="panel-toggle" class="icon-button panel-toggle" type="button" aria-expanded="true" aria-controls="map" aria-label="Show less of the panel" title="Show less of the panel" data-i18n-attrs="aria-label title">{% icon "collapse" %}</button>
        <div class="search">
          <div class="search-field">
            {% icon "search" %}
            <input id="search" type="search" placeholder="Search places and activities" aria-label="Search places and activities" data-i18n-attrs="placeholder aria-label" autocomplete="off" aria-controls="search-results" aria-expanded="false" aria-keyshortcuts="/">
          </div>
          <div id="search-results" class="search-results" role="region" aria-label="Search results" data-i18n-attrs="aria-label" aria-live="polite" hidden></div>
        </div>
        <p id="status" role="status"></p>
        <p id="sync-status" role="status"></p>
        <section id="detail" class="detail" hidden>
          <div class="detail-header">
            <div>
              <h2 id="detail-title"></h2>
              <p id="detail-meta" class="muted"></p>
            </div>
            <div class="detail-nav">
              <button id="detail-previous" class="icon-button" type="button" aria-label="Previous activity" title="Previous activity" data-i18n-attrs="aria-label title">{% icon "previous" %}</button>
              <button id="detail-next" class="icon-button" type="button" aria-label="Next activity" title="Next activity" data-i18n-attrs="aria-label title">{% icon "next" %}</button>
              <button id="detail-close" class="icon-button" type="button" aria-label="Show all activities" title="Show all activities" data-i18n-attrs="aria-label title">{% icon "close" %}</button>
            </div>
          </div>
          <p id="detail-description" class="detail-description"></p>
          <div id="detail-actions" class="detail-actions" hidden>
            <div id="detail-download" class="split-button">
              <a id="detail-original" class="panel-button" download>{% icon "download" %}<span id="detail-original-label">FIT</span></a>
              <button id="detail-download-more" class="panel-button" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="detail-download-menu" aria-label="More formats" title="More formats" data-i18n-attrs="aria-label title">{% icon "expand" %}</button>
              <div id="detail-download-menu" class="menu" role="menu" hidden>
                <a id="detail-menu-original" role="menuitem" download>FIT</a>
                <a id="detail-gpx" role="menuitem" download>GPX</a>
              </div>
            </div>
            <a id="detail-garmin" class="panel-button" target="_blank" rel="noopener" title="Garmin Connect">Garmin{% icon "external" %}</a>
            <button id="detail-route" class="panel-button" type="button" aria-label="Save as route" title="Save as route" data-i18n-attrs="aria-label title">{% icon "route" %}</button>
            <button id="detail-resync" class="panel-button" type="button" aria-label="Update" title="Update" data-i18n-attrs="aria-label title">{% icon "sync" %}</button>
          </div>
          <div id="detail-images" class="detail-images" hidden></div>
          <p id="detail-status" class="muted" role="status"></p>
          <div id="detail-profile" class="detail-profile" hidden>
            <div id="profile-tabs" class="profile-tabs" role="group" aria-label="Profile" data-i18n-attrs="aria-label"></div>
            <div id="profile-chart" class="profile-chart"></div>
            <div id="profile-readout" class="profile-readout" aria-live="polite"></div>
          </div>
          <label id="track-color-field" class="track-color" hidden>
            <span data-i18n>Track color</span>
            <select id="track-color"></select>
          </label>
          <dl id="detail-metrics" class="metrics"></dl>
          <section id="detail-race" class="race">
            <div id="race-view" hidden>
              <h3 data-i18n>Race result</h3>
              <p id="race-summary" class="race-summary"></p>
            </div>
            <button id="race-edit" class="panel-button" type="button">{% icon "trophy" %}<span id="race-edit-label" data-i18n>Enter race result</span></button>
            <form id="race-form" class="race-form" hidden>
              <h3 data-i18n>Race result</h3>
              <label><span data-i18n>Distance</span>
                <select name="distance">
                  <option value="5000" data-i18n>5 km</option>
                  <option value="10000" data-i18n>10 km</option>
                  <option value="21097.5" data-i18n>Half marathon</option>
                  <option value="42195" data-i18n>Marathon</option>
                  <option value="other" data-i18n>Other distance</option>
                </select>
              </label>
              <label id="race-other" hidden><span data-i18n>Distance in km</span> <input name="other_km" type="number" min="0" step="any"></label>
              <label><span data-i18n>Official time</span> <input name="time" placeholder="1:29:59" pattern="(\d+:)?\d{1,2}:\d{2}" required autocomplete="off"></label>
              <label><span data-i18n>Race</span> <input name="event" autocomplete="off"></label>
              <label><span data-i18n>Link to the official results</span> <input name="results_url" type="url" placeholder="https://"></label>
              <div class="panel-actions">
                <button class="primary-button" type="submit" data-i18n>Save</button>
                <button id="race-cancel" class="panel-button" type="button" data-i18n>Cancel</button>
                <button id="race-remove" class="panel-button danger-button" type="button" data-i18n>Remove</button>
              </div>
            </form>
          </section>
          <section id="detail-laps" hidden>
            <h3 data-i18n>Splits</h3>
            <div></div>
          </section>
          <section id="detail-splits" hidden>
            <h3 data-i18n>Fastest splits</h3>
            <dl class="metrics"></dl>
          </section>
          <section id="detail-zones" hidden>
            <h3 data-i18n>Heart rate zones</h3>
            <div></div>
          </section>
        </section>
        <section id="route-detail" class="detail" hidden>
          <div class="detail-header">
            <div>
              <h2 id="route-title"></h2>
              <p id="route-meta" class="muted"></p>
            </div>
            <div class="detail-nav">
              <button id="route-close" class="icon-button" type="button" aria-label="Show all activities" title="Show all activities" data-i18n-attrs="aria-label title">{% icon "close" %}</button>
            </div>
          </div>
          <p id="route-description" class="detail-description"></p>
          <div class="panel-actions">
            <a id="route-download" class="panel-button" download>{% icon "download" %}<span>GPX</span></a>
            <a id="route-activity" class="panel-button" hidden data-i18n>Activity</a>
            <button id="route-edit" class="panel-button" type="button" data-i18n>Edit</button>
            <button id="route-delete" class="panel-button danger-button" type="button" data-i18n>Delete</button>
          </div>
          <form id="route-form" class="route-form" hidden>
            <label><span data-i18n>Name</span>
              <input name="name" maxlength="200" required autocomplete="off">
            </label>
            <label><span data-i18n>Description</span>
              <input name="description" maxlength="5000" autocomplete="off">
            </label>
            <div class="panel-actions">
              <button class="primary-button" type="submit" data-i18n>Save</button>
              <button id="route-cancel" class="panel-button" type="button" data-i18n>Cancel</button>
            </div>
          </form>
          <p id="route-status" class="muted" role="status"></p>
        </section>
        <div id="browse">
        <p id="stats"></p>
        {% include "filters.njk" %}
        </div>
        <div class="legend" id="legend" hidden>
          <div id="legend-ramp" class="legend-ramp"></div>
          <div class="legend-labels"><span id="legend-low" data-i18n>Fewer activities</span><span id="legend-high" data-i18n>More activities</span></div>
        </div>
      </div>
    </section>
    <dialog id="photo-dialog" class="photo-dialog" aria-label="Photo" data-i18n-attrs="aria-label">
      <img id="photo-image" alt="">
      <button id="photo-previous" class="icon-button" type="button" aria-label="Previous photo" title="Previous photo" data-i18n-attrs="aria-label title">{% icon "previous" %}</button>
      <button id="photo-next" class="icon-button" type="button" aria-label="Next photo" title="Next photo" data-i18n-attrs="aria-label title">{% icon "next" %}</button>
      <button id="photo-close" class="icon-button" type="button" aria-label="Close" title="Close" data-i18n-attrs="aria-label title">{% icon "close" %}</button>
    </dialog>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/heatmap.js"></script>
  </body>
</html>
