<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Runmap</title>
    <meta name="theme-color" content="#f6f7f8" media="(prefers-color-scheme: light)" data-scheme="light">
    <meta name="theme-color" content="#0f1214" media="(prefers-color-scheme: dark)" data-scheme="dark">
    <script src="/js/theme.js"></script>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="stylesheet" href="/vendor/maplibre-gl.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main id="map" aria-label="Heatmap of all activities" data-i18n-attrs="aria-label"></main>
    <section class="panel">
      <div class="panel-body">
        {% include "header.njk" %}
        <div class="search">
          <div class="search-field">
            {% icon "search" %}
            <input id="search" type="search" placeholder="Search places and activities" aria-label="Search places and activities" data-i18n-attrs="placeholder aria-label" autocomplete="off">
          </div>
          <div id="search-results" class="search-results" hidden></div>
        </div>
        <p id="status" role="status"></p>
        <p id="sync-status" role="status"></p>
        <section id="detail" class="detail" hidden>
          <div class="detail-header">
            <div>
              <h2 id="detail-title"></h2>
              <p id="detail-meta" class="muted"></p>
            </div>
            <div class="detail-nav">
              <button id="detail-previous" class="icon-button" type="button" aria-label="Previous activity" title="Previous activity" data-i18n-attrs="aria-label title">{% icon "previous" %}</button>
              <button id="detail-next" class="icon-button" type="button" aria-label="Next activity" title="Next activity" data-i18n-attrs="aria-label title">{% icon "next" %}</button>
              <button id="detail-close" class="icon-button" type="button" aria-label="Show all activities" title="Show all activities" data-i18n-attrs="aria-label title">{% icon "close" %}</button>
            </div>
          </div>
          <p id="detail-description" class="detail-description"></p>
          <div id="detail-actions" class="detail-actions" hidden>
            <a id="detail-original" class="panel-button" download data-i18n>Original file</a>
            <a id="detail-gpx" class="panel-button" download>GPX</a>
            <a id="detail-garmin" class="panel-button" target="_blank" rel="noopener" data-i18n>Garmin Connect</a>
            <button id="detail-resync" class="panel-button" type="button" data-i18n>Download again</button>
          </div>
          <div id="detail-images" class="detail-images" hidden></div>
          <p id="detail-status" class="muted" role="status"></p>
          <div id="detail-profile" class="detail-profile" hidden>
            <div id="profile-tabs" class="profile-tabs" role="group" aria-label="Profile" data-i18n-attrs="aria-label"></div>
            <div id="profile-chart" class="profile-chart"></div>
            <div id="profile-readout" class="profile-readout" aria-live="polite"></div>
          </div>
          <label id="track-color-field" class="track-color" hidden>
            <span data-i18n>Track color</span>
            <select id="track-color"></select>
          </label>
          <dl id="detail-metrics" class="metrics"></dl>
          <section id="detail-laps" hidden>
            <h3 data-i18n>Splits</h3>
            <table class="laps">
              <thead><tr><th data-i18n>km</th><th data-i18n>Time</th><th id="laps-speed" data-i18n>Pace</th><th data-i18n>Heart rate</th><th data-i18n>Elevation</th></tr></thead>
              <tbody></tbody>
            </table>
          </section>
          <section id="detail-splits" hidden>
            <h3 data-i18n>Fastest splits</h3>
            <dl class="metrics"></dl>
          </section>
          <section id="detail-zones" hidden>
            <h3 data-i18n>Heart rate zones</h3>
            <div></div>
          </section>
        </section>
        <div id="browse">
        <p id="stats"></p>
        {% include "filters.njk" %}
        </div>
        <div class="legend" id="legend" hidden>
          <div id="legend-ramp" class="legend-ramp"></div>
          <div class="legend-labels"><span id="legend-low" data-i18n>Fewer activities</span><span id="legend-high" data-i18n>More activities</span></div>
        </div>
      </div>
    </section>
    <dialog id="photo-dialog" class="photo-dialog" aria-label="Photo" data-i18n-attrs="aria-label">
      <img id="photo-image" alt="">
      <button id="photo-previous" class="icon-button" type="button" aria-label="Previous photo" title="Previous photo" data-i18n-attrs="aria-label title">{% icon "previous" %}</button>
      <button id="photo-next" class="icon-button" type="button" aria-label="Next photo" title="Next photo" data-i18n-attrs="aria-label title">{% icon "next" %}</button>
      <button id="photo-close" class="icon-button" type="button" aria-label="Close" title="Close" data-i18n-attrs="aria-label title">{% icon "close" %}</button>
    </dialog>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/heatmap.js"></script>
  </body>
</html>
