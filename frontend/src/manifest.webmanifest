{
  "id": "/",
  "name": "Firn",
  "short_name": "Firn",
  "description": "A heatmap of your Garmin activities, with statistics on training, sleep and health.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f7f8",
  "theme_color": "#f6f7f8",
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Activities", "url": "/activities/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistics", "url": "/stats/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
