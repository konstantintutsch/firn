<!doctype html>
<html lang="en">
  {%- set title = "Runmap settings" %}
  {% include "head.njk" %}
  <body class="page">
    <header class="page-header">
      {% include "header.njk" %}
      <p id="sync-status" role="status"></p>
    </header>
    <main class="settings-page">
      <section class="card">
        <h2 data-i18n>Settings</h2>
        <p id="settings-account" class="muted"></p>
        <form id="key-form">
          <label><span data-i18n>Garmin Personal API key</span>
            <input name="api_key" type="password" autocomplete="off" required>
          </label>
          <p class="muted">
            <span data-i18n>Create one on</span>
            <a href="https://connect.garmin.com/app/settings/personalApiToken" target="_blank" rel="noreferrer">Garmin Connect</a>.
            <span data-i18n>Runmap stores it encrypted and never shows it again.</span>
          </p>
          <p id="key-status" class="muted"></p>
          <div class="panel-actions">
            <button class="primary-button" type="submit" data-i18n>Save key</button>
            <button id="key-remove" class="panel-button" type="button" hidden data-i18n>Remove key</button>
          </div>
        </form>
        <p id="settings-message" role="status"></p>
      </section>
      <section class="card">
        <h2 data-i18n>Your data</h2>
        <p class="muted" data-i18n>An export holds all activities with their files and photos, and the health data. Importing it restores them, here or in another Runmap.</p>
        <p class="muted" data-i18n>Import also takes a ZIP of FIT, GPX or TCX files from other apps and devices.</p>
        <div class="panel-actions">
          <a class="panel-button" href="/api/export" download data-i18n>Export</a>
          <label class="panel-button file-button">
            <span data-i18n>Import ZIP</span>
            <input id="import-file" type="file" accept=".zip,application/zip">
          </label>
        </div>
        <progress id="import-progress" max="1" value="0" hidden></progress>
        <p id="import-message" role="status"></p>
      </section>
      <section class="card">
        <h2 data-i18n>Appearance</h2>
        <div id="theme-picker" class="theme-picker" role="group" aria-label="Theme" data-i18n-attrs="aria-label">
          <button class="panel-button" type="button" data-theme-choice="system" data-i18n>System</button>
          <button class="panel-button" type="button" data-theme-choice="light" data-i18n>Light mode</button>
          <button class="panel-button" type="button" data-theme-choice="dark" data-i18n>Dark mode</button>
        </div>
        <h3 data-i18n>Units</h3>
        <div id="units-picker" class="theme-picker" role="group" aria-label="Units" data-i18n-attrs="aria-label">
          <button class="panel-button" type="button" data-choice="metric" data-i18n>Kilometers and meters</button>
          <button class="panel-button" type="button" data-choice="imperial" data-i18n>Miles and feet</button>
        </div>
        <h3 data-i18n>Language</h3>
        <div id="language-picker" class="theme-picker" role="group" aria-label="Language" data-i18n-attrs="aria-label">
          <button class="panel-button" type="button" data-choice="" data-i18n>System</button>
          <button class="panel-button" type="button" data-choice="en">English</button>
          <button class="panel-button" type="button" data-choice="de">Deutsch</button>
        </div>
      </section>
      <section class="card">
        <h2 data-i18n>Account</h2>
        <p id="last-sync" class="muted"></p>
        <div class="panel-actions">
          <button id="sign-out" class="panel-button" type="button" data-i18n>Sign out</button>
          <button id="delete-account" class="panel-button danger-button" type="button" data-i18n>Delete account</button>
        </div>
        <p id="account-message" role="status"></p>
      </section>
    </main>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/settings.js"></script>
  </body>
</html>
