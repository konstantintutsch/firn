{#- The head of every page. Set `title`, and `map` on the page with the map. #}
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ title }}</title>
    <meta name="theme-color" content="#f6f7f8" media="(prefers-color-scheme: light)" data-scheme="light">
    <meta name="theme-color" content="#0f1214" media="(prefers-color-scheme: dark)" data-scheme="dark">
    <script src="/js/theme.js"></script>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    {%- if map %}
    <link rel="stylesheet" href="/vendor/maplibre-gl.css">
    {%- endif %}
    <link rel="stylesheet" href="/css/style.css">
  </head>
