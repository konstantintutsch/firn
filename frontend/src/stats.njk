<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Runmap statistics</title>
    <script>
      // Applies a saved theme before the first paint, to avoid a flash of the wrong one.
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="theme-color" content="#f6f7f8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f1214" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="page">
    <header class="page-header">
      {% include "header.njk" %}
      <p id="sync-status" role="status"></p>
    </header>
    <main class="statistics">
      <div class="period">
        <div class="range-picker" role="group" aria-label="Period" data-i18n-attrs="aria-label">
          <button class="panel-button" type="button" data-days="7" data-i18n>7 days</button>
          <button class="panel-button" type="button" data-days="30" data-i18n>30 days</button>
          <button class="panel-button" type="button" data-days="90" data-i18n>90 days</button>
          <button class="panel-button" type="button" data-days="365" data-i18n>1 year</button>
          <button class="panel-button" type="button" data-days="all" data-i18n>All</button>
        </div>
        <div class="range period-dates">
          <label><span data-i18n>From</span> <input name="from" type="date" form="filters"></label>
          <label><span data-i18n>To</span> <input name="to" type="date" form="filters"></label>
        </div>
      </div>
      {% set filterDates = false %}
      {% include "filters.njk" %}
      <p id="statistics-status" role="status"></p>
      <section id="activity-section" hidden>
        <h2 data-i18n>Activities</h2>
        <div id="activity-tiles" class="tiles"></div>
        <div id="activity-charts" class="cards"></div>
      </section>
      <section id="health-section" hidden>
        <h2 data-i18n>Health</h2>
        <p id="health-note" class="muted" data-i18n hidden>Health values are filtered by the dates only.</p>
        <div id="health-tiles" class="tiles"></div>
        <div id="health-charts" class="cards"></div>
      </section>
    </main>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/stats.js"></script>
  </body>
</html>
