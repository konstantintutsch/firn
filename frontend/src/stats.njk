<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Runmap statistics</title>
    <script>
      // Applies a saved theme before the first paint, to avoid a flash of the wrong one.
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="page">
    <header class="page-header">
      {% include "header.njk" %}
      <p id="sync-status" role="status"></p>
    </header>
    <main class="statistics">
      <div class="range-picker" role="group" aria-label="Period">
        <button class="panel-button" type="button" data-days="30">30 days</button>
        <button class="panel-button" type="button" data-days="90">90 days</button>
        <button class="panel-button" type="button" data-days="365">1 year</button>
        <button class="panel-button" type="button" data-days="all">All</button>
      </div>
      <p id="statistics-status" role="status"></p>
      <section id="activity-section" hidden>
        <h2>Activities</h2>
        <div id="activity-tiles" class="tiles"></div>
        <div id="activity-charts" class="cards"></div>
      </section>
      <section id="health-section" hidden>
        <h2>Health</h2>
        <div id="health-tiles" class="tiles"></div>
        <div id="health-charts" class="cards"></div>
      </section>
    </main>
    {% include "account.njk" %}
    <script type="module" src="/js/stats.js"></script>
  </body>
</html>
