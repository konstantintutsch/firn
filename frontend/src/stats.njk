<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Runmap statistics</title>
    <script>
      // Applies a saved theme before the first paint, to avoid a flash of the wrong one.
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
      // Only Chromium refracts through an SVG filter in backdrop-filter; other browsers keep the plain blur.
      if (navigator.userAgentData) document.documentElement.classList.add("refract");
    </script>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="page">
    {% include "glass.njk" %}
    <header class="page-header">
      {% include "header.njk" %}
      <p id="sync-status" role="status"></p>
    </header>
    <main class="statistics">
      <div class="range-picker" role="group" aria-label="Period" data-i18n-attrs="aria-label">
        <button class="panel-button" type="button" data-days="30" data-i18n>30 days</button>
        <button class="panel-button" type="button" data-days="90" data-i18n>90 days</button>
        <button class="panel-button" type="button" data-days="365" data-i18n>1 year</button>
        <button class="panel-button" type="button" data-days="all" data-i18n>All</button>
      </div>
      <p id="statistics-status" role="status"></p>
      <section id="activity-section" hidden>
        <h2 data-i18n>Activities</h2>
        <div id="activity-tiles" class="tiles"></div>
        <div id="activity-charts" class="cards"></div>
      </section>
      <section id="health-section" hidden>
        <h2 data-i18n>Health</h2>
        <div id="health-tiles" class="tiles"></div>
        <div id="health-charts" class="cards"></div>
      </section>
    </main>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/stats.js"></script>
  </body>
</html>
