<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Runmap activities</title>
    <script src="/js/theme.js"></script>
    <meta name="theme-color" content="#f6f7f8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f1214" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="page">
    <header class="page-header">
      {% include "header.njk" %}
      <p id="sync-status" role="status"></p>
    </header>
    <main class="activity-page">
      <div class="search-field">
        {% icon "search" %}
        <input id="activity-search" type="search" placeholder="Search activities" aria-label="Search activities" data-i18n-attrs="placeholder aria-label" autocomplete="off">
      </div>
      <p id="activity-status" role="status"></p>
      <ul id="activity-list" class="activity-list"></ul>
      <button id="activity-more" class="panel-button" type="button" hidden data-i18n>Load more</button>
    </main>
    {% include "nav.njk" %}
    {% include "account.njk" %}
    <script type="module" src="/js/activities.js"></script>
  </body>
</html>
